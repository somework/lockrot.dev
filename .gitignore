# Build outputs and the lockrot checkout scripts/fetch-lockrot.sh makes.
/site/
/build/
/.lockrot/
# Local Python environment and caches.
/.venv/
/.cache/
__pycache__/
.DS_Store
# Browser-check leftovers (Playwright MCP snapshots).
/.playwright-mcp/
# IndexNow state and report, written by the action's image when it runs locally.
/.indexnow/
/state/
# The assembled viewer site (scripts/build-viewer.sh writes it).
/viewer-site/
# wrangler writes the Cloudflare account id here after a local deploy. Not a secret the way a
# token is, but it is an account identifier in a public repository, and it is a build artefact.
/.wrangler/
# The report renderer releases scripts/fetch-renderer.sh downloads: the one lockrot vendors, and
# lockrot-report 0.13.0 for the stored report-1 capsules (scripts/build-viewer.sh).
/.renderer/
/.renderer-report-1/
# The schemas-only checkout of SCHEMAS_REF (scripts/fetch-schemas.sh).
/.schemas/
